{
  "name": "cliphive",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "lint:root": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "turbo": "^1.13.4",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "eslint": "^9.12.0",
    "typescript-eslint": "^8.8.0",
    "globals": "^15.9.0"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract", "unrs-resolver"]
  }
}
