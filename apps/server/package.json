    "@fastify/rate-limit": "^9.1.0",
    "@ffprobe-installer/ffprobe": "^1.4.1",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "axios": "^1.7.3",
    "bullmq": "^5.12.0",
    "crypto-js": "^4.2.0",
